<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <GridLayout
            android:id="@+id/gridTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <!-- Row 1 -->
            <Button
                android:id="@+id/btnNotepad"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="📝\nBloc de notas"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnChatBot"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="🤖\nChatBot IA"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCalendar"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="📅\nCalendario"
                android:textSize="12sp" />

            <!-- Row 2 -->
            <Button
                android:id="@+id/btnWhatsApp"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="💬\nLink WhatsApp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCalculator"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="🧮\nCalculadora"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDrawing"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="🎨\nBloc de dibujos"
                android:textSize="12sp" />

            <!-- Row 3 -->
            <Button
                android:id="@+id/btnQR"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="📷\nLector QR"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMaps"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="🗺️\nMapas"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConverter"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="🔄\nConvertidor"
                android:textSize="12sp" />

            <!-- Row 4 -->
            <Button
                android:id="@+id/btnPDF"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="📄\nLector PDF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLED"
                style="@style/Widget.HerramientasAivy.Button"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:text="💡\nPanel LED"
                android:textSize="12sp" />

        </GridLayout>

        <!-- Banner AdMob -->
        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

</ScrollView>
